 "html": "<style>\n\t.boqi-print { font-family: \"Helvetica Neue\", Arial, sans-serif; color: #1a2733; font-size: 11.5px; }\n\t.boqi-print h1 { font-size: 18px; margin: 0 0 10px; color: #0a2540; }\n\t.boqi-print table.boqi-table {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t}\n\t.boqi-print table.boqi-table th {\n\t\tcolor: #000;\n\t\ttext-align: left;\n\t\tpadding: 6px 8px;\n\t\tfont-size: 10.5px;\n\t\tborder: 1px solid;\n\t}\n\t.boqi-print table.boqi-table td {\n\t\tpadding: 5px 8px;\n\t\tborder: 1px solid;\n\t\tfont-size: 11px;\n\t}\n\t.boqi-print .boqi-no-col { width: 5%; text-align: center; }\n\t.boqi-print .boqi-desc-col { width: 39%; }\n\t.boqi-print .boqi-unit-col { width: 8%; text-align: center; }\n\t.boqi-print .boqi-qty-col { width: 8%; text-align: center; }\n\t.boqi-print .boqi-rate-col { width: 20%; text-align: right; }\n\t.boqi-print .boqi-amount-col { width: 20%; text-align: right; }\n\t.boqi-print tr.boqi-section td {\n\t\tbackground: #f8dede;\n\t\tfont-weight: 700;\n\t}\n\t.boqi-print tr.boqi-sub-item td {\n\t\tcolor: #4a5568;\n\t}\n\t.boqi-print .boqi-sub-item-desc {\n\t\tpadding-left: 18px;\n\t}\n\t.boqi-print td.boqi-r {\n\t\ttext-align: right;\n\t}\n\t.boqi-print td.boqi-c {\n\t\ttext-align: center;\n\t}\n</style>\n\n<div class=\"boqi-print\">\n\t{%- set roman_upper = [\"I\",\"II\",\"III\",\"IV\",\"V\",\"VI\",\"VII\",\"VIII\",\"IX\",\"X\",\"XI\",\"XII\",\"XIII\",\"XIV\",\"XV\",\"XVI\",\"XVII\",\"XVIII\",\"XIX\",\"XX\"] -%}\n\t{%- set roman_lower = [\"i\",\"ii\",\"iii\",\"iv\",\"v\",\"vi\",\"vii\",\"viii\",\"ix\",\"x\",\"xi\",\"xii\",\"xiii\",\"xiv\",\"xv\",\"xvi\",\"xvii\",\"xviii\",\"xix\",\"xx\"] -%}\n\t{%- set counters = namespace(section=0, item=0, sub=0) -%}\n\n    <p>{{ doc.customer_name }}</p>\n    <p>{{ doc.project_name }}</p>\n    <p>{{ doc.custom_scope_of_work }}</p>\n    <br>\n\n\t<table class=\"boqi-table\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th class=\"boqi-no-col\">No.</th>\n\t\t\t\t<th class=\"boqi-desc-col\">Description</th>\n\t\t\t\t<th class=\"boqi-unit-col\">Unit</th>\n\t\t\t\t<th class=\"boqi-qty-col\">Qty</th>\n\t\t\t\t<th class=\"boqi-rate-col\">Rate</th>\n\t\t\t\t<th class=\"boqi-amount-col\">Amount</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{%- for row in doc.items -%}\n\t\t\t\t{%- if row.custom_category_type == \"Section\" -%}\n\t\t\t\t\t{%- set counters.section = counters.section + 1 -%}\n\t\t\t\t\t{%- set counters.item = 0 -%}\n\t\t\t\t\t{%- set counters.sub = 0 -%}\n\t\t\t\t\t<tr class=\"boqi-section\">\n\t\t\t\t\t\t<td class=\"boqi-c\">{{ roman_upper[counters.section - 1] if counters.section <= 20 else counters.section }}</td>\n\t\t\t\t\t\t<td colspan=\"5\">{{ row.description or row.item_name }}</td>\n\t\t\t\t\t</tr>\n\t\t\t\t{%- elif row.custom_category_type == \"Sub Item\" -%}\n\t\t\t\t\t{%- set counters.sub = counters.sub + 1 -%}\n\t\t\t\t\t<tr class=\"boqi-sub-item\">\n\t\t\t\t\t\t<td class=\"boqi-c\">{{ roman_lower[counters.sub - 1] if counters.sub <= 20 else counters.sub }}</td>\n\t\t\t\t\t\t<td class=\"boqi-sub-item-desc\">{{ row.description or row.item_name }}</td>\n\t\t\t\t\t\t<td></td>\n\t\t\t\t\t\t<td></td>\n\t\t\t\t\t\t<td></td>\n\t\t\t\t\t\t<td></td>\n\t\t\t\t\t</tr>\n\t\t\t\t{%- else -%}\n\t\t\t\t\t{%- set counters.item = counters.item + 1 -%}\n\t\t\t\t\t{%- set counters.sub = 0 -%}\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td class=\"boqi-c\">{{ counters.item }}</td>\n\t\t\t\t\t\t<td>{{ row.description or row.item_name }}</td>\n\t\t\t\t\t\t<td class=\"boqi-c\">{{ row.uom or \"\" }}</td>\n\t\t\t\t\t\t<td class=\"boqi-c\">{{ row.qty or \"\" }}</td>\n\t\t\t\t\t\t<td class=\"boqi-r\">\n\t\t\t\t\t\t\t{%- if row.custom_amount_remark -%}\n\t\t\t\t\t\t\t\t\u2014\n\t\t\t\t\t\t\t{%- else -%}\n\t\t\t\t\t\t\t\t{{ row.get_formatted(\"rate\", doc) }}\n\t\t\t\t\t\t\t{%- endif -%}\n\t\t\t\t\t\t</td>\n\t\t\t\t\t\t<td class=\"boqi-r\">\n\t\t\t\t\t\t\t{%- if row.custom_amount_remark -%}\n\t\t\t\t\t\t\t\t{{ row.custom_amount_remark }}\n\t\t\t\t\t\t\t{%- else -%}\n\t\t\t\t\t\t\t\t{{ row.get_formatted(\"amount\", doc) }}\n\t\t\t\t\t\t\t{%- endif -%}\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t{%- endif -%}\n\t\t\t{%- else -%}\n\t\t\t\t<tr><td colspan=\"6\">No BOQ lines added yet.</td></tr>\n\t\t\t{%- endfor -%}\n\t\t\t<tr class=\"boqi-section\">\n\t\t\t    <td></td>\n\t\t\t    <td colspan=4>Total Amount</td>\n                <td class=\"boqi-amount-col\">{{ doc.get_formatted(\"total\") }}</td>\n            </tr>\n\t\t</tbody>\n\t</table>\n</div>\n",
