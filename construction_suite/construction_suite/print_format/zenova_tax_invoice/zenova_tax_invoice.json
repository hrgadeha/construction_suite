 "font_size": 14,
 "html": "\n<style>\n\t.zs-inv { font-family: \"Helvetica Neue\", Arial, sans-serif; color: #1a1a1a; font-size: 12px; }\n\t.zs-inv table { border-collapse: collapse; }\n\t.zs-inv .zs-header-tbl { width: 100%; margin-bottom: 6px; }\n\t.zs-inv .zs-header-tbl td { vertical-align: top; padding: 0; }\n\t.zs-inv .zs-logo { max-width: 90px; max-height: 80px; }\n\t.zs-inv .zs-company-name { font-size: 16px; font-weight: 700; color: #d6339a; margin: 2px 0; }\n\t.zs-inv .zs-company-meta { font-size: 11px; line-height: 1.5; }\n\t.zs-inv .zs-date { clear: both; text-align: right; font-size: 11px; margin-top: 6px; }\n\t.zs-inv .zs-rule { border-top: 3px solid #e8935c; margin: 6px 0 12px; }\n\t.zs-inv .zs-billto-tbl { width: 100%; margin-bottom: 10px; }\n\t.zs-inv .zs-billto-tbl td { vertical-align: top; padding: 0; }\n\t.zs-inv .zs-label { font-weight: 700; }\n\t.zs-inv .zs-invno { text-align: right; font-weight: 700; }\n\t.zs-inv table.zs-items { width: 100%; margin-bottom: 10px; }\n\t.zs-inv table.zs-items th {\n\t\tbackground: #f3b3d6; color: #1a1a1a; text-align: left; padding: 6px 8px; font-size: 11px; border: 1px solid #d98cc0;\n\t}\n\t.zs-inv table.zs-items td {\n\t\tpadding: 4px 8px; border: 1px solid #d9d9d9; font-size: 11.5px; vertical-align: top;\n\t}\n\t.zs-inv table.zs-items td.r, .zs-inv table.zs-items th.r { text-align: right; }\n\t.zs-inv table.zs-items td.c, .zs-inv table.zs-items th.c { text-align: center; }\n\t.zs-inv tr.zs-caption td { font-weight: 700; }\n\t.zs-inv .zs-bottom-tbl { width: 100%; margin-top: 6px; }\n\t.zs-inv .zs-bottom-tbl td { vertical-align: top; padding: 0; }\n\t.zs-inv .zs-remit { font-size: 11px; line-height: 1.6; }\n\t.zs-inv table.zs-totals { width: 100%; }\n\t.zs-inv table.zs-totals td { padding: 4px 8px; border: 1px solid #d9d9d9; font-size: 12px; }\n\t.zs-inv table.zs-totals td.r { text-align: right; }\n\t.zs-inv table.zs-totals tr.zs-grand td { font-weight: 700; }\n\t.zs-inv .zs-sign-block { margin-top: 40px; text-align: right; }\n\t.zs-inv .zs-sign-block .zs-sign-name { margin-top: 45px; font-weight: 700; }\n</style>\n\n{%- set company_tax_id = frappe.db.get_value(\"Company\", doc.company, \"tax_id\") -%}\n{%- set gst_rate = (doc.taxes[0].rate if doc.taxes else 9) -%}\n{%- set company_display_name = doc.company -%}\n\n<div class=\"zs-inv\" style=\"width:100%;\">\n\t<table class=\"zs-header-tbl\">\n\t    <tr>\n\t        <td colspan=\"2\" style=\"width:100%; background: #f3b3d6; color: #1a1a1a;\"><b><center>TAX INVOICE</center></b></td>\n\t    </tr>\n\t\t<tr>\n\t\t\t<td style=\"width:75%;\">\n\t\t\t\t<img class=\"zs-logo\" src=\"/files/download.png\">\n\t\t\t\t<div class=\"zs-company-name\">{{ company_display_name }}</div>\n\t\t\t\t<div class=\"zs-company-meta\">\n\t\t\t\t\t2 Leng Kee Road, #04-11, Thye Hong Centre, Singapore 159086<br>\n\t\t\t\t\tCo.Reg No/GST Reg No: {{ company_tax_id or \"\" }}<br>\n\t\t\t\t\tTel: 9722 9388 &nbsp; Email: general@zenovasteel.com\n\t\t\t\t</div>\n\t\t\t</td>\n\t\t\t<td style=\"width:25%;\">\n\t\t\t\tDate : {{ doc.get_formatted(\"posting_date\") }}\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\t<div class=\"zs-rule\"></div>\n\n\t<table class=\"zs-billto-tbl\">\n\t\t<tr>\n\t\t\t<td style=\"width:55%;\">\n\t\t\t\t<div class=\"zs-label\">BILL TO:</div>\n\t\t\t\t<div><u>{{ doc.customer_name }}</u></div>\n\t\t\t\t<div>{{ doc.address_display or \"\" }}</div>\n\t\t\t\t<br>\n\t\t\t\t{%- if doc.project %}\n\t\t\t\t<div><span class=\"zs-label\">Project:</span> {{ frappe.db.get_value(\"Project\", doc.project, \"project_name\") or doc.project }}</div>\n\t\t\t\t{%- endif %}\n\t\t\t\t{%- if doc.custom_scope_of_work %}\n\t\t\t\t<div><span class=\"zs-label\">Scope of Work:</span> {{ doc.custom_scope_of_work }}</div>\n\t\t\t\t{%- endif %}\n\t\t\t\t<br>\n\t\t\t\t<div>Attn : Accounts Department</div>\n\t\t\t</td>\n\t\t\t<td style=\"width:45%;\">\n\t\t\t\t<div class=\"zs-invno\">INVOICE NO: {{ doc.name }}</div>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\n\t<table class=\"zs-items\">\n\t\t<thead>\n\t\t\t<tr>\n\t\t\t\t<th class=\"c\" style=\"width:5%;\">No</th>\n\t\t\t\t<th>Description</th>\n\t\t\t\t<th class=\"c\" style=\"width:10%;\">Unit</th>\n\t\t\t\t<th class=\"r\" style=\"width:10%;\">Qty</th>\n\t\t\t\t<th class=\"r\" style=\"width:18%;\">Unit Price</th>\n\t\t\t\t<th class=\"r\" style=\"width:18%;\">Amount</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{%- for row in doc.items %}\n\t\t\t<tr{% if row.custom_caption_row %} class=\"zs-caption\"{% endif %}>\n\t\t\t\t<td class=\"c\">{{ row.idx }}</td>\n\t\t\t\t<td>{{ row.description or row.item_name }}</td>\n\t\t\t\t{%- if not row.custom_caption_row %}\n\t\t\t\t<td class=\"c\">{{ row.uom }}</td>\n\t\t\t\t<td class=\"r\">{{ row.get_formatted(\"qty\", doc) }}</td>\n\t\t\t\t<td class=\"r\">{{ row.get_formatted(\"rate\", doc) }}</td>\n\t\t\t\t{%- else %}\n\t\t\t\t<td class=\"c\"></td>\n\t\t\t\t<td class=\"r\"></td>\n\t\t\t\t<td class=\"r\"></td>\n\t\t\t\t{%- endif %}\n\t\t\t\t<td class=\"r\">\n\t\t\t\t\t{%- if row.amount < 0 -%}\n\t\t\t\t\t\t({{ frappe.utils.fmt_money(-1 * row.amount, currency=doc.currency) }})\n\t\t\t\t\t{%- else -%}\n\t\t\t\t\t\t{{ frappe.utils.fmt_money(row.amount, currency=doc.currency) }}\n\t\t\t\t\t{%- endif -%}\n\t\t\t\t</td>\n\t\t\t</tr>\n\t\t\t{%- endfor %}\n\t\t</tbody>\n\t</table>\n\n\t<table class=\"zs-bottom-tbl\">\n\t\t<tr>\n\t\t\t<td style=\"width:58%;\">\n\t\t\t\t<div class=\"zs-remit\">\n\t\t\t\t\tPlease remit in favour of {{ company_display_name }}<br>\n\t\t\t\t\t<span class=\"zs-label\">Payment Details :</span><br>\n\t\t\t\t\tBeneficiary : {{ company_display_name }}<br>\n\t\t\t\t\tBank Name : DBS Bank Singapore<br>\n\t\t\t\t\tSwift Code : DBSSGSG<br>\n\t\t\t\t\tA/C No : 072-11637-30\n\t\t\t\t</div>\n\t\t\t</td>\n\t\t\t<td style=\"width:42%;\">\n\t\t\t\t<table class=\"zs-totals\">\n\t\t\t\t\t<tr><td>Sub-Total</td><td class=\"r\">{{ doc.get_formatted(\"net_total\") }}</td></tr>\n\t\t\t\t\t<tr><td>GST {{ gst_rate }}%</td><td class=\"r\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td></tr>\n\t\t\t\t\t<tr class=\"zs-grand\"><td>Total</td><td class=\"r\">{{ doc.get_formatted(\"grand_total\") }}</td></tr>\n\t\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</table>\n\n\t<div class=\"zs-sign-block\">\n\t\t<div>{{ company_display_name }}</div>\n\t\t<div class=\"zs-sign-name\"></div>\n\t\t<div>Director</div>\n\t</div>\n</div>\n",
